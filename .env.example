# Скопируй в .env и заполни. .env НЕ коммитить.
# Какой LLM использует ассистент: nvidia | openai | anthropic | none
LLM_PROVIDER=nvidia
# модель с build.nvidia.com, поддерживающая tool calling (выбирает агент danial, согласует с командой)
LLM_MODEL=

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
